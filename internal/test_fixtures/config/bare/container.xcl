# a declaration led by its variety, container "mine", rather than by the
# resource kind. The leading keyword names a type the registry knows, so the
# single label is the name of the thing being declared.
resource "network" "onprem" {
  subnet = "10.6.0.0/16"
}

container "mine" {
  command = ["consul", "agent", "-dev", "-client", "0.0.0.0"]

  network {
    name       = resource.network.onprem.meta.name
    ip_address = "10.6.0.200"
  }

  dns = ["a", "b", "c"]

  resources {
    memory  = 1024
    cpu_pin = [1]
  }
}

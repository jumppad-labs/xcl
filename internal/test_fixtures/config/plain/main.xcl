agent "claude" {
  models = ["opus", "sonnet"]
}

agent "ollama" {
  enabled = false
}

database "postgres" "main" {
  port = 5432
}

organization "hidden" {
  capacity = 1

  agent "claude" {
    models = ["sonnet"]
  }
}

job "build" {
  command = "make"
}

job "deploy" {
  depends_on = ["job.build"]
  command    = "make deploy port=${database.postgres.main.port}"
}

job "off" {
  disabled = true
  command  = "never"
}

unlabelled "only" {
  value = "kept ${agent.claude.name} ${database.postgres.main.engine}"
}

service "api" {
  database  = database.postgres.main
  databases = [database.postgres.main]
}

service "api" {
  host = "api.local"

  listener "http" {
    port = 80
  }

  listener "https" {
    port = 443
    tls  = true
  }
}

variable "index" {
  default = 1
}

gateway "edge" {
  ports   = { for l in service.api.listener : l.name => l.port }
  port    = service.api.listener[variable.index].port
  address = (service.api).host
}

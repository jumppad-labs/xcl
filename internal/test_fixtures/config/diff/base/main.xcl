# The configuration every diff scenario is applied from first: a network and
# two containers attached to it.

resource "network" "app" {
  subnet = "10.0.0.0/16"
}

resource "container" "api" {
  network {
    name = resource.network.app.meta.name
  }

  env = {
    PORT = "8080"
  }
}

resource "container" "web" {
  network {
    name = resource.network.app.meta.name
  }

  env = {
    PORT = "80"
  }
}

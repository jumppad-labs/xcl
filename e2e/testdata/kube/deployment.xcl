# The end-to-end suite's Kubernetes-like configuration, decoded into the Go
# types in e2e/fixtures/kube. No plugin and no provider is involved: the blocks
# are decoded into Go structs and the references between them are resolved.
#
# Variables can be overridden with environment variables prefixed HCL_VAR_,
# i.e. HCL_VAR_image_tag.
variable "image_tag" {
  default = "1.2.0"
}

variable "replicas" {
  default = 3
}

# config_map holds values whose names are not known to the Go type, its data
# is a map. The deployment reads single values out of it below.
config_map "api" {
  data = {
    db_host   = "postgres.default.svc"
    log_level = "info"
  }
}

deployment "api" {
  replicas = variable.replicas

  # container is a repeated block, this deployment has two of them
  container {
    name  = "api"
    image = "ghcr.io/example/api:${variable.image_tag}"

    # port is repeated in turn, a block nested inside a block
    port {
      name           = "http"
      container_port = 8080
    }

    port {
      name           = "metrics"
      container_port = 9090
    }

    # env values are read from the config map, so they are declared once
    env {
      name  = "DB_HOST"
      value = config_map.api.data.db_host
    }

    env {
      name  = "LOG_LEVEL"
      value = config_map.api.data.log_level
    }

    # the password comes from a secret, the deployment holds only the
    # secret's name and the key to read, never the password itself
    env {
      name = "DB_PASSWORD"

      value_from {
        secret_key_ref {
          name = secret.db.meta.name
          key  = "password"
        }
      }
    }

    # resources nests two more blocks of its own
    resources {
      limits {
        cpu    = "500m"
        memory = "512Mi"
      }

      requests {
        cpu    = "100m"
        memory = "128Mi"
      }
    }

    volume_mount {
      name = "config"
      path = "/etc/api"
    }
  }

  container {
    name  = "proxy"
    image = "ghcr.io/example/proxy:0.4.1"

    port {
      name           = "proxy"
      container_port = 8081
    }
  }

  volume {
    name       = "config"
    config_map = config_map.api.meta.id
  }
}